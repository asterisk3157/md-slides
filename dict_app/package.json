{
  "name": "pptx-auto-dict",
  "version": "0.1.0",
  "private": true,
  "description": "手書き文字バリエーション辞書登録Webアプリ (Cloudflare Pages + D1)",
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB=pptx_auto_dict --local --persist-to=.wrangler/state --port 8788 --ip 0.0.0.0",
    "db:init": "node scripts/init-local-db.mjs",
    "db:init:remote": "wrangler d1 execute pptx_auto_dict --remote --file=./schema.sql",
    "deploy": "wrangler pages deploy public --project-name pptx-auto-dict"
  },
  "devDependencies": {
    "wrangler": "^4.93.0"
  }
}
